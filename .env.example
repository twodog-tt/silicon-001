# 币安广场 OpenAPI key 也可放 ~/.config/binance-square/openapi-key
BINANCE_SQUARE_OPENAPI_KEY=
QINGTING_HUMAN_WRITING_CHECK=1
US_PRE_CACHE_TTL=600
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-plus
# 封面默认用服务器 matplotlib PNG；1 才调用百炼文生图
SQUARE_AI_COVER=0
# 1 才调用币安 OpenAPI 真发；缺省或 --dry-run 只出 reports/
SQUARE_PUBLISH=0
# 三币串发间隔秒数（dry-run 固定为 0）
SQUARE_JOB_STAGGER_SEC=90
# 美股主源是新浪/腾讯；Yahoo 在国内 ECS 通常不可达，不要开
US_PRE_YF=0
# 4H 默认走 Binance；国内用 vision，主站 api.binance.com 常不可达
QINGTING_CRYPTO_MARKET_SOURCE=binance
BINANCE_API_BASE=https://data-api.binance.vision
# 广场发文专用 HTTP 代理（自己的香港机隧道或付费代理）。不要用公司机器。
# 隧道方案：SQUARE_HTTPS_PROXY=http://127.0.0.1:8888
# 不要设全局 HTTPS_PROXY，否则新浪/百炼也会被代理。
SQUARE_HTTPS_PROXY=
