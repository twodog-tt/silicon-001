# 币安广场 OpenAPI key 也可放 ~/.config/binance-square/openapi-key
BINANCE_SQUARE_OPENAPI_KEY=
QINGTING_HUMAN_WRITING_CHECK=1
US_PRE_CACHE_TTL=600
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-plus
# 1 才调用币安 OpenAPI 真发；缺省或 --dry-run 只出 reports/
SQUARE_PUBLISH=0
# 三币串发间隔秒数（dry-run 固定为 0）
SQUARE_JOB_STAGGER_SEC=90
